{
  "name": "@ibo-mike/dsh-font-tuner",
  "version": "0.1.0",
  "description": "DeepSeek Harness (dsh) 桌面端/Web GUI 字体调整：覆盖 --dsw-font-family / --dsw-font-prose / --ds-font-family-code 等字体 CSS 变量，附带设置卡片。",
  "license": "MIT",
  "author": {
    "name": "IBO-Mike",
    "email": "swft2006@gmail.com",
    "url": "https://github.com/IBO-Mike"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IBO-Mike/dsh-font-tuner.git"
  },
  "homepage": "https://github.com/IBO-Mike/dsh-font-tuner#readme",
  "bugs": {
    "url": "https://github.com/IBO-Mike/dsh-font-tuner/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "font",
    "typography",
    "theme"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ]
}
